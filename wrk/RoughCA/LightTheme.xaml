<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<!-- Theme Accent & Semantic Colors (Light) -->
	<SolidColorBrush x:Key="HeaderDividerBrush" Color="#1F000000" />
	<SolidColorBrush x:Key="AccentBadgeBackgroundBrush" Color="#1A0067C0" />
	<SolidColorBrush x:Key="AccentBadgeForegroundBrush" Color="#005A9E" />
	<SolidColorBrush x:Key="AccentBadgeBorderBrush" Color="#330067C0" />

	<SolidColorBrush x:Key="StatusValidBackgroundBrush" Color="#1F107C10" />
	<SolidColorBrush x:Key="StatusValidForegroundBrush" Color="#0E6A0E" />
	<SolidColorBrush x:Key="StatusWarningBackgroundBrush" Color="#24C19C00" />
	<SolidColorBrush x:Key="StatusWarningForegroundBrush" Color="#8A5A00" />
	<SolidColorBrush x:Key="StatusDangerBackgroundBrush" Color="#1FC42B1C" />
	<SolidColorBrush x:Key="StatusDangerForegroundBrush" Color="#B42318" />
	<SolidColorBrush x:Key="StatusNeutralBackgroundBrush" Color="#14000000" />
	<SolidColorBrush x:Key="StatusNeutralForegroundBrush" Color="#525252" />

	<SolidColorBrush x:Key="DangerAccentForegroundBrush" Color="#C42B1C" />
	<SolidColorBrush x:Key="LogPanelBackgroundBrush" Color="#B8FFFFFF" />

	<ThemeShadow x:Key="CardShadow" />

	<Style x:Key="CardStyleStackPanel" TargetType="StackPanel">
		<Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
		<Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="CornerRadius" Value="8" />
	</Style>

	<Style x:Key="CardStyleGrid" TargetType="Grid">
		<Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
		<Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="CornerRadius" Value="8" />
	</Style>

	<Style x:Key="CardStyleListView" TargetType="ListView">
		<Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
		<Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="CornerRadius" Value="8" />
	</Style>

	<Style x:Key="CardStyleExpander" TargetType="Expander">
		<Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
		<Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
		<Setter Property="CornerRadius" Value="8" />
	</Style>

	<Style x:Key="BodyLargeTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
		<Setter Property="FontSize" Value="18" />
		<Setter Property="FontWeight" Value="SemiBold" />
	</Style>

	<Style x:Key="CaptionPane" TargetType="Grid">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="Padding" Value="24,12,24,8" />
	</Style>

	<Style x:Key="CaptionText" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
		<Setter Property="Margin" Value="0" />
	</Style>

	<Style x:Key="SectionHeaderTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
		<Setter Property="FontSize" Value="15" />
		<Setter Property="Margin" Value="0,0,0,8" />
	</Style>

	<Style x:Key="ItemCaptionTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
		<Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
	</Style>
</ResourceDictionary>
