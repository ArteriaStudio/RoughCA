<?xml version="1.0" encoding="utf-8"?>
<!--
================================================================================
  File        : VersionPage.xaml
  Description : バージョン情報・謝辞・表示言語確認画面
  Author      : Gemini 4 Neon（綴）
  Updated     : 2026-11-20
================================================================================
-->
<Page
	x:Class="Arteria_s.App.RoughCA.VersionPage"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="using:Arteria_s.App.RoughCA"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	mc:Ignorable="d"
	Background="Transparent">

	<ScrollViewer Padding="24,16,24,24">
		<StackPanel MaxWidth="680" HorizontalAlignment="Left" Spacing="16">
			<!-- アプリ情報カード -->
			<Grid Style="{ThemeResource CardStyleGrid}" Padding="20,16,20,16" ColumnSpacing="16">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="*" />
				</Grid.ColumnDefinitions>

				<Border Grid.Column="0" CornerRadius="12" Width="64" Height="64" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
					<Image Source="ms-appx:///Assets/EasyCA.jpg" Width="64" Height="64" Stretch="UniformToFill" />
				</Border>

				<StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
					<TextBlock x:Uid="VersionInfo" Style="{ThemeResource ItemCaptionTextBlockStyle}" />
					<TextBlock Text="Arteria Studio RoughCA" Style="{ThemeResource SubtitleTextBlockStyle}" />
					<Border Background="{ThemeResource AccentBadgeBackgroundBrush}" CornerRadius="8" Padding="8,2,8,2" HorizontalAlignment="Left">
						<TextBlock Text="Ver 0.1.0.1" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AccentBadgeForegroundBrush}" />
					</Border>
				</StackPanel>
			</Grid>

			<!-- 謝辞カード -->
			<StackPanel Style="{ThemeResource CardStyleStackPanel}" Padding="20,16,20,16" Spacing="8">
				<TextBlock x:Uid="Acknowledgment" Name="Acknowledgment" Style="{ThemeResource SectionHeaderTextBlockStyle}" />
				<TextBlock Style="{ThemeResource ItemCaptionTextBlockStyle}" Text="This application works thanks to the technologies described below." TextWrapping="Wrap" Margin="0,0,0,4" />
				<Border Height="1" Background="{ThemeResource HeaderDividerBrush}" Margin="0,2,0,4" />
				<TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="• Microsoft Visual Studio C# (Language)" />
				<TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="• Microsoft .NET / Windows App SDK (Framework, UI Library)" />
				<TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="• PostgreSQL (Data Store)" />
				<TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="• SQLite (Local Data Store)" />
				<TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="• Microsoft Image Creator (Create Icon)" />
			</StackPanel>

			<!-- 表示言語カード -->
			<Grid Style="{ThemeResource CardStyleGrid}" Padding="20,14,20,14">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>
				<TextBlock x:Uid="DisplayLanguage" Grid.Column="0" VerticalAlignment="Center" Style="{ThemeResource BodyStrongTextBlockStyle}" />
				<Border Grid.Column="1" Background="{ThemeResource StatusNeutralBackgroundBrush}" CornerRadius="6" Padding="10,4,10,4" VerticalAlignment="Center">
					<TextBlock Name="DisplayLanguage" Style="{ThemeResource BodyTextBlockStyle}" Text="{x:Bind m_pLanguage}" />
				</Border>
			</Grid>
		</StackPanel>
	</ScrollViewer>
</Page>
