================================================================================
-->
<Page
	x:Class="ArteriaS.App.RoughCA.IssuePage"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="using:ArteriaS.App.RoughCA"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	mc:Ignorable="d"
	Background="Transparent">

	<ScrollViewer Padding="24,16,24,24">
		<StackPanel MaxWidth="680" HorizontalAlignment="Left" Spacing="16">
			<!-- 証明書種別・発行元認証局カード -->
			<StackPanel Style="{ThemeResource CardStyleStackPanel}" Padding="20,16,20,16" Spacing="12">
				<StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
					<FontIcon Glyph="&#xEB95;" FontSize="16" Foreground="{ThemeResource AccentBadgeForegroundBrush}" />
					<TextBlock Text="証明書タイプ・発行元" Style="{ThemeResource SectionHeaderTextBlockStyle}" Margin="0" />
				</StackPanel>
				<ComboBox x:Uid="IssuerAuthority" x:Name="IssuerAuthority" Header="発行元の認証局" MinWidth="320" HorizontalAlignment="Stretch" SelectionChanged="IssuerAuthority_SelectionChanged" />
				<ComboBox x:Uid="CertificateType" x:Name="CertificateType" Header="証明書の種類" MinWidth="320" HorizontalAlignment="Stretch" SelectionChanged="CertificateType_SelectionChanged">
					<ComboBoxItem x:Uid="ServerCertificate" Tag="Server" Content="サーバー証明書" />
					<ComboBoxItem x:Uid="ClientCertificate" Tag="Client" Content="クライアント証明書" />
					<ComboBoxItem x:Uid="RDSignCertificate" Tag="RDSign" Content="リモートデスクトップリスナー証明書" />
					<ComboBoxItem x:Uid="CACertificate"     Tag="CA"     Content="認証局証明書" />
					<ComboBoxItem x:Uid="CodeCertificate"   Tag="Code"   Content="コード署名証明書" />
				</ComboBox>
			</StackPanel>

			<!-- パラメータ入力カード -->
			<StackPanel Style="{ThemeResource CardStyleStackPanel}" Padding="20,16,20,20" Spacing="14">
				<StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
					<FontIcon Glyph="&#xE8A5;" FontSize="16" Foreground="{ThemeResource AccentBadgeForegroundBrush}" />
					<TextBlock Text="証明書パラメータ" Style="{ThemeResource SectionHeaderTextBlockStyle}" Margin="0" />
				</StackPanel>

				<TextBox x:Uid="CommonName"  x:Name="CommonName"  Header="共通名" Text="{x:Bind m_pForm.m_pCommonName, Mode=TwoWay}"  PlaceholderText="証明書に記載する名前"  TextChanged="TextBox_TextChanged" />
				<TextBox x:Uid="HostName"    x:Name="HostName"    Header="FQDN"  Text="{x:Bind m_pForm.m_pHostName, Mode=TwoWay}"    PlaceholderText="FQDN形式での識別名称" TextChanged="TextBox_TextChanged" />
				<TextBox x:Uid="MailAddress" x:Name="MailAddress" Header="メール" Text="{x:Bind m_pForm.m_pMailAddress, Mode=TwoWay}" PlaceholderText="メールアドレス"       TextChanged="TextBox_TextChanged" />
				<TextBox x:Uid="NetAddress"  x:Name="NetAddress"  Header="ネットアドレス" Text="{x:Bind m_pForm.m_pNetAddress, Mode=TwoWay}" PlaceholderText="192.168.0.1"  TextChanged="TextBox_TextChanged" />

				<Border Height="1" Margin="0,4,0,4" Background="{ThemeResource HeaderDividerBrush}" />

				<StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
					<Button x:Uid="IssueButton" x:Name="IssueButton" Style="{StaticResource AccentButtonStyle}" MinWidth="120" IsEnabled="False" Content="発行" Click="IssueButton_Click" />
				</StackPanel>
			</StackPanel>
		</StackPanel>
	</ScrollViewer>
</Page>
