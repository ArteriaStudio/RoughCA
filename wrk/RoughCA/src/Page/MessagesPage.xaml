<?xml version="1.0" encoding="utf-8"?>
<!--
================================================================================
  File        : MessagesPage.xaml
  Description : 下部メッセージログパネル（種別バッジ・件数表示・開閉制御）
  Author      : Gemini 4 Neon（綴）
  Updated     : 2026-11-20
================================================================================
-->
<Page
	x:Class="Arteria_s.App.RoughCA.MessagesPage"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="using:Arteria_s.App.RoughCA"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	mc:Ignorable="d"
	Background="Transparent">

	<Border Background="{ThemeResource LogPanelBackgroundBrush}"
			BorderBrush="{ThemeResource HeaderDividerBrush}"
			BorderThickness="0,1,0,0">
		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="*"/>
			</Grid.RowDefinitions>

			<!-- ログヘッダーバー -->
			<Grid Grid.Row="0" Padding="24,6,16,6" Background="Transparent">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="Auto"/>
				</Grid.ColumnDefinitions>

				<StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
					<FontIcon Glyph="&#xE756;" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
					<TextBlock Style="{ThemeResource ItemCaptionTextBlockStyle}" FontWeight="SemiBold" x:Uid="MessageLog" Text="メッセージログ" VerticalAlignment="Center" />
					<Border Background="{ThemeResource StatusNeutralBackgroundBrush}" CornerRadius="10" Padding="7,1,7,1" VerticalAlignment="Center">
						<TextBlock x:Name="LogCountText" Text="0" FontSize="11" Foreground="{ThemeResource StatusNeutralForegroundBrush}" />
					</Border>
				</StackPanel>

				<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
					<Button x:Name="ClearLogButton" Click="ClearLogButton_Click" Padding="8,4,8,4" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="ログをクリア">
						<FontIcon Glyph="&#xE74D;" FontSize="12" />
					</Button>
					<Button x:Name="ToggleExpandButton" Click="ToggleExpandButton_Click" Padding="8,4,8,4" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="ログパネルを開閉">
						<FontIcon x:Name="ToggleExpandIcon" Glyph="&#xE70D;" FontSize="12" />
					</Button>
				</StackPanel>
			</Grid>

			<!-- ログリスト -->
			<ListView x:Name="LogListView"
					  Grid.Row="1"
					  Margin="16,0,16,6"
					  SelectionMode="None"
					  ItemsSource="{x:Bind m_pMessages}">
				<ListView.ItemContainerStyle>
					<Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
						<Setter Property="HorizontalContentAlignment" Value="Stretch" />
						<Setter Property="MinHeight" Value="28" />
						<Setter Property="Padding" Value="0" />
						<Setter Property="Margin" Value="0,1,0,1" />
					</Style>
				</ListView.ItemContainerStyle>
				<ListView.ItemTemplate>
					<DataTemplate x:DataType="local:Message">
						<Grid ColumnSpacing="10" Padding="4,4,8,4">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="4"/>
								<ColumnDefinition Width="74"/>
								<ColumnDefinition Width="86"/>
								<ColumnDefinition Width="1.2*"/>
								<ColumnDefinition Width="0.5*"/>
								<ColumnDefinition Width="0.8*"/>
							</Grid.ColumnDefinitions>

							<!-- 左端アクセントバー -->
							<Border Grid.Column="0"
									CornerRadius="2"
									Background="{x:Bind local:MessagesPage.GetFacilityForeground(Facility)}"
									Margin="0,2,0,2" />

							<!-- 種別バッジ -->
							<Border Grid.Column="1"
									Background="{x:Bind local:MessagesPage.GetFacilityBackground(Facility)}"
									CornerRadius="4"
									Padding="6,1,6,1"
									HorizontalAlignment="Left"
									VerticalAlignment="Center">
								<TextBlock Text="{x:Bind local:MessagesPage.GetFacilityLabel(Facility)}"
										   Foreground="{x:Bind local:MessagesPage.GetFacilityForeground(Facility)}"
										   FontSize="10"
										   FontWeight="SemiBold" />
							</Border>

							<!-- 時刻 -->
							<TextBlock Grid.Column="2"
									   Text="{x:Bind TimeAt}"
									   FontFamily="Consolas"
									   FontSize="12"
									   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
									   VerticalAlignment="Center" />

							<!-- メッセージ本文 -->
							<TextBlock Grid.Column="3"
									   Text="{x:Bind Text}"
									   Style="{ThemeResource BodyTextBlockStyle}"
									   FontSize="12"
									   TextTrimming="CharacterEllipsis"
									   VerticalAlignment="Center" />

							<!-- 対象識別子 -->
							<TextBlock Grid.Column="4"
									   Text="{x:Bind Which}"
									   Style="{ThemeResource ItemCaptionTextBlockStyle}"
									   TextTrimming="CharacterEllipsis"
									   VerticalAlignment="Center" />

							<!-- 対象パス -->
							<TextBlock Grid.Column="5"
									   Text="{x:Bind Where}"
									   Style="{ThemeResource ItemCaptionTextBlockStyle}"
									   TextTrimming="CharacterEllipsis"
									   VerticalAlignment="Center" />
						</Grid>
					</DataTemplate>
				</ListView.ItemTemplate>
			</ListView>
		</Grid>
	</Border>
</Page>
